# Singitronic E-Commerce Environment Configuration
NODE_ENV=development

# Ports (3000 = Website & Admin, 3001 = Backend REST API)
PORT=3001
BACKEND_INTERNAL_URL=http://127.0.0.1:3001
NEXT_PUBLIC_API_BASE_URL=

# Embedded SQLite database (works automatically on Windows, macOS & Linux)
DATABASE_URL="file:./prisma/dev.db"

# Authentication (NextAuth)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=12D16C923BA17672F89B18C1DB22A9F8E7D6C5B4A3
AUTH_TRUST_HOST=true
