# Frontend & Prisma Environment Configuration (Singitronic)
NODE_ENV=development

# Leave empty so the browser talks to Next.js relative /api/* proxy routes
NEXT_PUBLIC_API_BASE_URL=

# Internal Express API target used by Next.js rewrites
BACKEND_INTERNAL_URL=http://127.0.0.1:3001

# Portable SQLite database path (works on Windows, macOS, and Linux)
DATABASE_URL="file:./prisma/dev.db"

# NextAuth configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=12D16C923BA17672F89B18C1DB22A9F8E7D6C5B4A3
AUTH_TRUST_HOST=true
